# ── SSO（消費端，只需要公鑰來源與幾個 URL，絕不碰 auth 私鑰）──────
AUTH_JWKS_URL=https://auth.lvh.me:3000/.well-known/jwks.json
AUTH_AUTHORIZE_URL=https://auth.lvh.me:3000/api/auth/authorize
AUTH_LOGOUT_URL=https://auth.lvh.me:3000/api/auth/logout
MEETING_SELF_URL=https://meeting.lvh.me:3009
# 契約 v2：本服務在 tpass-registry 登記的服務 id
TPASS_SERVICE_ID=meeting
JWT_ISSUER=https://auth.lvh.me:3000
# 門戶大廳（正式環境換 https://portal.tschoolsu.org）
PORTAL_URL=https://portal.lvh.me:3001
# 選填：/denied 頁網址。未設就由 AUTH_AUTHORIZE_URL 的 origin 推導 ${origin}/denied。
# AUTH_DENIED_URL=

# ── 資料庫（不是 Prisma：直接用 pg，schema 由服務自己 CREATE TABLE IF NOT EXISTS）──
POSTGRES_URL=postgresql://t_meeting@localhost:5432/t_meeting

# ── 服務自己的設定（都是選填）──
# 部會清單的一次性種子（逗號分隔）：只在 DB 還沒有任何部會時匯入，之後由 admin 在 /panel 管理
DEPARTMENTS=
# 是否允許一般學生自行建立會議（"true" 才開）
ALLOW_STUDENT_CREATE=false
# Email 通知（SMTP_HOST 與 SMTP_FROM 都有值才會寄；沒設就只進佇列不派送）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
